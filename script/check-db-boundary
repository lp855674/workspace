#!/usr/bin/env bash
# DB-02: Only crates/db may use sqlx; no SQL in other crates.
set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

echo "=== 1. Check cargo tree -i sqlx: only db directly depends on sqlx ==="
TREE=$(cargo tree -i sqlx 2>/dev/null || true)
if ! echo "$TREE" | head -20 | grep -q "db v"; then
    echo "ERROR: sqlx dependency tree does not show db as a direct dependent"
    cargo tree -i sqlx
    exit 1
fi
echo "  OK: db is the direct sqlx consumer"

echo "=== 2. Scan crates (except db) for sqlx:: or sqlx usage ==="
VIOLATIONS=$(rg "sqlx::|use sqlx|from sqlx" crates/ --glob '!crates/db/**' 2>/dev/null || true)
if [ -n "$VIOLATIONS" ]; then
    echo "ERROR: sqlx usage found outside crates/db:"
    echo "$VIOLATIONS"
    exit 1
fi
echo "  OK: no sqlx usage outside db"

echo "=== 3. Scan crates (except db) for sqlx::query / sqlx::query_as in .rs files ==="
SQL_VIOLATIONS=$(rg -l "sqlx::query|sqlx::query_as" crates/ --glob '!crates/db/**' --type rust 2>/dev/null || true)
if [ -n "$SQL_VIOLATIONS" ]; then
    echo "ERROR: SQL queries found outside crates/db:"
    echo "$SQL_VIOLATIONS"
    exit 1
fi
echo "  OK: no SQL outside db"

echo "=== DB boundary check passed ==="
